# Copy to .env for `netlify dev`, and set the same variables in
# Netlify → Site configuration → Environment variables for production.
# Never commit a real key. The key is only read by netlify/functions/chat.mts.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Required: any model ID from https://openrouter.ai/models
# (models ending in ":free" cost nothing but have strict rate limits)
OPENROUTER_MODEL=

# Your deployed site URL, sent to OpenRouter as the HTTP-Referer header
SITE_URL=https://your-site.netlify.app
